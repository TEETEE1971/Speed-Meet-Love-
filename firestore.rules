rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Speed Meet Love Durable Collections
    // Server-authoritative backend interacts with Firestore for persistent member storage
    match /users/{userId} {
      allow read, write: if true;
    }
    match /banned_users/{userId} {
      allow read, write: if true;
    }
    match /reports/{reportId} {
      allow read, write: if true;
    }
    match /granted_testers/{emailDocId} {
      allow read, write: if true;
    }
    match /system_test/{testId} {
      allow read, write: if true;
    }
  }
}
