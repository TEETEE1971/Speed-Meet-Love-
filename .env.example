# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this application is hosted.
# Configured for production custom domain https://speedmeetlove.com.
APP_URL="https://speedmeetlove.com"

# LIVEKIT CONFIGURATION: Required for production WebRTC video speed-dating rooms.
# Sign up for a free Community tier at https://cloud.livekit.io (50 GB bandwidth/month free).
# Never expose these keys in client-side code; they are used exclusively on the server to mint short-lived tokens.
LIVEKIT_URL="wss://speed-meet-love-xxxxxx.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
LIVEKIT_API_SECRET="your_livekit_secret_key_here"

# STRIPE SANDBOX CONFIGURATION: Required for server-authenticated Stripe subscriptions & webhooks.
# Configure these in Cloud Run environment variables or user secrets.
# Never expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET to client-side code.
STRIPE_SECRET_KEY="sk_test_your_stripe_test_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret_here"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_test_publishable_key_here"

# Pre-configured Stripe Price IDs:
STRIPE_PRICE_ID_PREMIUM="price_1UZJGCGzWqYTtaSTwzOMdDqO"
STRIPE_PRICE_ID_PREMIUM_PLUS="price_1UZJR6GzWqYTtaSTVJCIeJip"

# OUTBOUND TRANSACTIONAL EMAIL (Configure Resend, SendGrid, or SMTP for verification emails)
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Speed Meet Love <noreply@speedmeetlove.com>"
